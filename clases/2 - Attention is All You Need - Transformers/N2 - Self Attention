393,"user_tz":180,"elapsed":6,"user":{"displayName":"Francisco Traversaro","userId":"11717466918051452843"}}},"source":["class Head(nn.Module):\n","    \"\"\" una cabeza de self-attention \"\"\"\n","\n","    def __init__(self, head_size):\n","        super().__init__()\n","        self.key   = nn.Linear(n_embd, head_size, bias=False)\n","        self.query = nn.Linear(n_embd, head_size, bias=False)\n","        self.value = nn.Linear(n_embd, head_size, bias=False)\n","        self.register_buffer('tril', torch.tril(torch.ones(block_size, block_size)))\n","\n","    def forward(self, x):\n","        B, T, C = x.shape\n","        k = self.key(x)     # (B,T,head_size)\n","        q = self.query(x)   # (B,T,head_size)\n","        # afinidades escaladas por 1/sqrt(head_size)  (acá head_size = C = n_embd)\n","        wei = q @ k.transpose(-2, -1) * C**-0.5                         # (B,T,T)\n","        wei = wei.masked_fill(self.tril[:T, :T] == 0, float('-inf'))    # máscara causal\n","        wei = F.softmax(wei, dim=-1)                                    # (B,T,T)\n","        v = self.value(x)   # (B,T,head_size)\n","        out = wei @ v       # (B,T,T) @ (B,T,head_size) -> (B,T,head_size)  (promedia los VALUES)\n","        return out\n","\n","\n","class BigramLanguageModelV3(nn.Module):\n","    \"\"\" v3: el promedio uniforme se reemplaza por UNA cabeza de self-attention (+ positional embedding) \"\"\"\n","\n","    def __init__(self):\n","        super().__init__()\n","        self.token_embedding_table    = nn.Embedding(vocab_size, n_embd)\n","        self.position_embedding_table = nn.Embedding(block_size, n_embd)\n","        self.sa_head = Head(n_embd)                     # una sola cabeza, head_size = n_embd\n","        self.lm_head = nn.Linear(n_embd, vocab_size)\n","\n","    def forward(self, idx, targets=None):\n","        B, T = idx.shape\n","        tok_emb = self.token_embedding_table(idx)                                    # (B,T,n_embd)\n","        pos_emb = self.position_embedding_table(torch.arange(T, device=idx.device))  # (T,n_embd)\n","        x = tok_emb + pos_emb                                                        # (B,T,n_embd)\n","        x = self.sa_head(x)                             # (B,T,n_embd) <- atención EN LUGAR del promedio uniforme\n","        logits = self.lm_head(x)                        # (B,T,vocab_size)\n","\n","        loss = None\n","        if targets is not None:\n","            B, T, C = logits.shape\n","            logits  = logits.view(B*T, C)\n","            targets = targets.view(B*T)\n","            loss = F.cross_entropy(logits, targets)\n","        return logits, loss\n","\n","    def generate(self, idx, max_new_tokens):\n","        for _ in range(max_new_tokens):\n","            idx_cond = idx[:, -block_size:]             # recorte a block_size (la tabla posicional es de tamaño fijo)\n","            logits, _ = self(idx_cond)\n","            logits = logits[:, -1, :]\n","            probs = F.softmax(logits, dim=-1)\n","            idx_next = torch.multinomial(probs, num_samples=1)\n","            idx = torch.cat((idx, idx_next), dim=1)\n","        return idx"],"id":"4a75023e","execution_count":17,"outputs":[]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"3490fa74","executionInfo":{"status":"ok","timestamp":1786454193741,"user_tz":180,"elapsed":46344,"user":{"displayName":"Francisco Traversaro","userId":"11717466918051452843"}},"outputId":"150e958d-ebff-4e80-aec8-c8cecdd0fb07"},"source":["torch.manual_seed(1337)\n","model_v3 = BigramLanguageModelV3().to(device)\n","print(sum(p.numel() for p in model_v3.parameters())/1e3, 'K parámetros')\n","train(model_v3)"],"id":"3490fa74","execution_count":18,"outputs":[{"output_type":"stream","name":"stdout","text":["7.553 K parámetros\n","step    0: train loss 4.2000, val loss 4.2047\n","step  500: train loss 2.6911, val loss 2.7087\n","step 1000: train loss 2.5196, val loss 2.5303\n","step 1500: train loss 2.4775, val loss 2.4829\n","step 2000: train loss 2.4408, val loss 2.4523\n","step 2500: train loss 2.4272, val loss 2.4435\n","step 3000: train loss 2.4130, val loss 2.4327\n","step 3500: train loss 2.3956, val loss 2.4212\n","step 4000: train loss 2.4041, val loss 2.3992\n","step 4500: train loss 2.3980, val loss 2.4084\n","step 5000: train loss 2.3946, val loss 2.4133\n","step 5500: train loss 2.3778, val loss 2.4139\n","step 6000: train loss 2.3912, val loss 2.3996\n","step 6500: train loss 2.3826, val loss 2.3873\n","step 7000: train loss 2.3793, val loss 2.3880\n","step 7500: train loss 2.3571, val loss 2.3981\n","step 8000: train loss 2.3568, val loss 2.3853\n","step 8500: train loss 2.3726, val loss 2.3912\n","step 9000: train loss 2.3622, val loss 2.3753\n","step 9500: train loss 2.3635, val loss 2.3773\n","step 9999: train loss 2.3552, val loss 2.3710\n"]},{"output_type":"execute_result","data":{"text/plain":["BigramLanguageModelV3(\n","  (token_embedding_table): Embedding(65, 32)\n","  (position_embedding_table): Embedding(8, 32)\n","  (sa_head): Head(\n","    (key): Linear(in_features=32, out_features=32, bias=False)\n","    (query): Linear(in_features=32, out_features=32, bias=False)\n","    (value): Linear(in_features=32, out_features=32, bias=False)\n","  )\n","  (lm_head): Linear(in_features=32, out_features=65, bias=True)\n",")"]},"metadata":{},"execution_count":18}]},{"cell_type":"code","metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"db3dfee3","executionInfo":{"status":"ok","timestamp":1786454194129,"user_tz":180,"elapsed":382,"user":{"displayName":"Francisco Traversaro","userId":"11717466918051452843"}},"outputId":"66adde9c-f358-4e67-98f1-2c33b5a8c1fa"},"source":["torch.manual_seed(1337)\n","context = torch.zeros((1, 1), dtype=torch.long, device=device)\n","print(decode(model_v3.generate(context, max_new_tokens=500)[0].tolist()))"],"id":"db3dfee3","execution_count":19,"outputs":[{"output_type":"stream","name":"stdout","text":["\n","And thif bridcowinen is by bt madiset bobe toe.\n","Sagrth my dalitanss:\n","Wanthaf us hat vet?\n","\n","Metlad ate awice my.\n","\n","Hand com onou thowns, tof is he me mil;\n","I lin,\n","Wh iree sen cie lat Het drovets, and the ngan iserans!\n","Al lind peal.\n","-hul qouchiry ptupr aiss haw ye n's nes normopeeelaves\n","Momy yuke tiothakeeo Windo whe Ceiiby we ati dourive cen, ire st so mower; th\n","To kind thrupt f so;\n","ARID Wam:\n","ET:\n","I inle ont ffaf Prred my om.\n","\n","He-\n","LIERLA,\n","Sby ake adsad this and thinin cour ay aney Iry ts I fr yo ve y\n"]}]},{"cell_type":"markdown","metadata":{"id":"85d5db80"},"source":["## Comparación\n","\n","Mirá los tres valores de **val loss**:\n","\n","- **Bigrama simple** (Notebook 1): ~2.5\n","- **v2** (memoria uniforme, sin posición): parecido o apenas distinto — el promedio uniforme diluye el token actual, que es el más predictivo, así que la memoria sola no ayuda de forma clara.\n","- **v3** (una cabeza de atención + posición): **baja** respecto de los anteriores.\n","\n","Y en el texto generado: sigue sin tener sentido, pero la **estructura** de v3 se acerca más a un guion (agrupaciones tipo palabra, saltos de línea). Esa mejora de estructura, no de sentido, es la señal de que la atención captura dependencias que el promedio uniforme no podía.\n","\n","**Próximo milestone:** multi-head attention y el bloque Transformer completo (feed-forward, residuales, LayerNorm)."],"id":"85d5db80"},{"cell_type":"markdown","source":["## Sección 4 — Multi-head attention\n","\n","### El límite de una sola cabeza\n","\n","La cabeza de la Sección 3 tiene un único par `W_Q` / `W_K`, así que aprende **una sola** noción de \"relevante\": para cada token produce una única distribución de atención. El problema es que en el lenguaje conviven varios tipos de relación al mismo tiempo —concordancia sujeto-verbo, proximidad, correferencia— y una sola distribución tiene que representarlos a todos mezclados en un promedio.\n","\n","### La idea: varias cabezas en paralelo\n","\n","**Multi-head attention** corre varias cabezas independientes en paralelo, cada una con sus propias `W_Q`, `W_K`, `W_V`. Como sus matrices son independientes, cada una calcula su propia atención sobre el mismo `x` — puede especializarse en un tipo de relación distinto. Son ramas independientes del cómputo: durante la atención no se comunican, recién se juntan al final con una **concatenación**.\n","\n","### El reparto de dimensión\n","\n","No se apilan cabezas de tamaño completo: se **reparte** el ancho. Con `num_heads` cabezas, cada una trabaja en un subespacio de tamaño `head_size = n_embd // num_heads`, y al concatenar las `num_heads` salidas se vuelve a `n_embd`. Acá: `n_embd = 32`, `num_heads = 4` → 4 cabezas de tamaño 8, y `4 × 8 = 32`.\n","\n","Dos consecuencias:\n","\n","- La salida sigue siendo `(B, T, n_embd)`, así que multi-head es un **reemplazo directo** de la cabeza única — no cambia nada alrededor (embeddings, `lm_head`, `generate`).\n","- El costo en parámetros es casi el mismo: una cabeza de tamaño `n_embd` y `num_heads` cabezas de tamaño `n_embd/num_heads` tienen la misma cantidad de parámetros en las proyecciones (`3 · n_embd²`), pero multi-head da `num_heads` patrones de atención independientes en vez de uno.\n","\n","> **La proyección final `W_O`.** Después del `concat`, las cabezas quedan apiladas en bloques de canales separados, sin mezclarse. Una capa lineal `W_O` (`nn.Linear(n_embd, n_embd)`) las **mezcla entre sí**, para que cada canal de salida combine lo que juntó cada cabeza. Es parte del multi-head: la operación completa es **concat + proyección**.\n","\n","*(Ver Parte 4 del deck.)*"],"metadata":{"id":"l_xF_rawwPjV"},"id":"l_xF_rawwPjV"},{"cell_type":"code","source":["# reutilizamos la clase Head de la Sección 3 (no hay que redefinirla)\n","num_heads = 4   # con n_embd = 32  ->  4 cabezas de tamaño 8\n","\n","class MultiHeadAttention(nn.Module):\n","    \"\"\" varias cabezas de self-attention en paralelo: concat + proyección W_O \"\"\"\n","\n","    def __init__(self, num_heads, head_size):\n","        super().__init__()\n","        self.heads = nn.ModuleList([Head(head_size) for _ in range(num_heads)])\n","        self.proj  = nn.Linear(n_embd, n_embd)     # W_O: mezcla lo que juntó cada cabeza\n","\n","    def forward(self, x):\n","        out = torch.cat([h(x) for h in self.heads], dim=-1)   # (B,T,n_embd) -- cabezas apiladas\n","        out = self.proj(out)                                   # (B,T,n_embd) -- W_O mezcla las cabezas\n","        return out"],"metadata":{"id":"TPb2V-KdwQIA","executionInfo":{"status":"ok","timestamp":1786454194451,"user_tz":180,"elapsed":318,"user":{"displayName":"Francisco Traversaro","userId":"11717466918051452843"}}},"id":"TPb2V-KdwQIA","execution_count":20,"outputs":[]},{"cell_type":"markdown","source":["### El modelo v4\n","\n","Igual que v3, pero la atención pasa de **una** cabeza a **varias**. El único cambio conceptual es la línea de la atención:\n","\n","- v3: `self.sa_head = Head(n_embd)`\n","- v4: `self.sa_heads = MultiHeadAttention(num_heads, n_embd // num_heads)`\n","\n","Todo lo demás —token + positional embedding, `lm_head`, `generate`— queda idéntico."],"metadata":{"id":"P0876MF7wZJp"},"id":"P0876MF7wZJp"},{"cell_type":"code","source":["class BigramLanguageModelV4(nn.Module):\n","    \"\"\" v4: multi-head attention (varias cabezas en paralelo) + positional embedding \"\"\"\n","\n","    def __init__(self):\n","        super().__init__()\n","        self.token_embedding_table    = nn.Embedding(vocab_size, n_embd)\n","        self.position_embedding_table = nn.Embedding(block_size, n_embd)\n","        self.sa_heads = MultiHeadAttention(num_heads, n_embd // num_heads)   # 4 cabezas de tamaño 8\n","        self.lm_head  = nn.Linear(n_embd, vocab_size)\n","\n","    def forward(self, idx, targets=None):\n","        B, T = idx.shape\n","        tok_emb = self.token_embedding_table(idx)                                    # (B,T,n_embd)\n","        pos_emb = self.position_embedding_table(torch.arange(T, device=idx.device))  # (T,n_embd)\n","        x = tok_emb + pos_emb                                                        # (B,T,n_embd)\n","        x = self.sa_heads(x)                            # (B,T,n_embd) <- multi-head EN LUGAR de una cabeza\n","        logits = self.lm_head(x)                        # (B,T,vocab_size)\n","\n","        loss = None\n","        if targets is not None:\n","            B, T, C = logits.shape\n","            logits  = logits.view(B*T, C)\n","            targets = targets.view(B*T)\n","            loss = F.cross_entropy(logits, targets)\n","        return logits, loss\n","\n","    def generate(self, idx, max_new_tokens):\n","        for _ in range(max_new_tokens):\n","            idx_cond = idx[:, -block_size:]\n","            logits, _ = self(idx_cond)\n","            logits = logits[:, -1, :]\n","            probs = F.softmax(logits, dim=-1)\n","            idx_next = torch.multinomial(probs, num_samples=1)\n","            idx = torch.cat((idx, idx_next), dim=1)\n","        return idx"],"metadata":{"id":"lKbpwF2pwai5","executionInfo":{"status":"ok","timestamp":1786454194460,"user_tz":180,"elapsed":5,"user":{"displayName":"Francisco Traversaro","userId":"11717466918051452843"}}},"id":"lKbpwF2pwai5","execution_count":21,"outputs":[]},{"cell_type":"code","source":["torch.manual_seed(1337)\n","model_v4 = BigramLanguageModelV4().to(device)\n","print(sum(p.numel() for p in model_v4.parameters())/1e3, 'K parámetros')\n","train(model_v4)"],"metadata":{"colab":{"base_uri":"https://localhost:8080/"},"id":"uShbSPW0wqVr","executionInfo":{"status":"ok","timestamp":1786454279718,"user_tz":180,"elapsed":85255,"user":{"displayName":"Francisco Traversaro","userId":"11717466918051452843"}},"outputId":"c68e2a12-58eb-425c-a204-8da25a873e48"},"id":"uShbSPW0wqVr","execution_count":22,"outputs":[{"output_type":"stream","name":"stdout","text":["8.609 K 